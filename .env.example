OPENROUTER_API_KEY=
AUTH_TOKEN=            # any long random string; only to enrol the first passkey, remove it afterwards (see README: Signing in)
TELEGRAM_BOT_TOKEN=    # from @BotFather
TELEGRAM_OWNER_ID=     # leave empty, message the bot, it replies with your id
TZ=UTC                 # your IANA timezone, e.g. Asia/Kolkata
# Optional
AGENT_MODEL=deepseek/deepseek-v4.1-flash
REFLECT_MODEL=qwen/qwen3.7-flash
FOREMAN_MODEL=deepseek/deepseek-v4.1-flash   # plans goals and judges evidence
REFLECT_EVERY_HOURS=12
MAX_SPEND_USD=20
DATA_DIR=./data
# Coding tasks run in throwaway containers in a separate Railway project (see README: Orchestrator).
SANDBOX_RAILWAY_TOKEN=         # project token scoped to the agent-sandboxes environment
SANDBOX_PROJECT_ID=
SANDBOX_ENVIRONMENT_ID=
OPENROUTER_MANAGEMENT_KEY=     # mints a capped model key per attempt
CODER_PROVIDER=openrouter      # or "opencode-go": coders use your OpenCode Go plan through the agent's proxy
CODER_MODEL=moonshotai/kimi-k2.7-code   # OpenCode Go names it kimi-k2.7-code (the default for opencode-go)
BLOG_PUBLIC_URL=               # the blog's public address, shown in the Artifacts panel (built-in blog default); unset = the blog row shows as unavailable
OPENCODE_API_KEY=              # OpenCode Go key (console); held by the agent only, never sent to containers
PAUSE_ALL=false                # maintenance: pause every goal, jobs and reflection; false resumes what it paused
REVIEWER_MODEL=z-ai/glm-5.3    # independent reviewer: keep it a different vendor from CODER_MODEL
# REVIEW_DIFF_CHARS=300000    # how many characters of a goal's diff the reviewer reads (also the raw-diff cap in compare()); anything but a positive integer up to a hard maximum of 1000000 falls back to the default (values above 1000000 also fall back, so the cap can never be turned off)
MERGE_VETO_MINUTES=5           # how long you can veto a merge into this repo
OBSERVE_MINUTES=5              # how long production is watched after a merge goes live (P0 = automatic revert)
DEPLOY_DEADLINE_MINUTES=15     # a merge not live on production by then counts as a failed deploy
SELF_MERGE=veto                # or "owner" to merge changes to this repo yourself
AUTO_APPROVE_PLANS=false       # autonomy mode: plans start without your code (you are still notified)
ATTEMPT_BUDGET_USD=3

# Advanced (defaults shown; leave commented unless you need them)
# PORT=3000
# PUBLIC_URL=                  # the agent's public address; on Railway it defaults to https://$RAILWAY_PUBLIC_DOMAIN
# RP_ID=                       # passkey relying party; defaults to PUBLIC_URL's host (localhost locally)
# THINKING_LEVEL=medium        # off | minimal | low | medium | high
# RESUME_PAUSED=false          # one-shot: resume every paused goal at boot, then unset it
# REVIEWER_PROVIDER=openrouter # or "opencode-go" (reviewer default model then gpt-6-luna)
# EXAMINER_PROVIDER=           # defaults to REVIEWER_PROVIDER
# EXAMINER_MODEL=              # writes hidden holdout checks; defaults to REVIEWER_MODEL
# SANDBOX_IMAGE=node:24        # set to your ghcr.io/<owner>/pi-agent-runner image (see README: Setup (once))
# OPENCODE_VERSION=1.19.3
# OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
# ATTEMPT_MINUTES=40
# MAX_PARALLEL_TASKS=2
# SANDBOX_VCPUS=2
# SANDBOX_MEMORY_GB=4
# GIT_AUTHOR_NAME=pi-agent
# GIT_AUTHOR_EMAIL=pi-agent@users.noreply.github.com
# CANVAS_ACCESS_TOKEN=         # enables the /canvas route and its Artifacts link; unset = disabled
# ELR_SYSTEM_ONE_MODEL=perplexity/pplx-decider-v1.1-27b
# ELR_SYSTEM_ONE_SECOND=inception/mercury-decide
# SKILL_<NAME>=                # secrets for self-written skills; the only env vars skills can see
# AGENT_URL=                   # your machine only, for `npm run railway` (e.g. https://<service>.up.railway.app)
